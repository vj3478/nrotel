import requests
import csv

API_KEY = "YOUR_NEW_RELIC_USER_API_KEY"
API_URL = "https://api.newrelic.com/graphql"

HEADERS = {
    "Content-Type": "application/json",
    "API-Key": API_KEY
}

QUERY = """
query($cursor: String) {
  actor {
    entitySearch(
      queryBuilder: {
        domain: INFRA
        type: HOST
        tags: [{ key: "account", value: "cgc-Cahkjhjkrd-PROD" }]
      }
      options: {
        tagFilter: [
          "account", "accountId", "aws.accountId", "tags.ASV", "tags.BA",
          "owner_contact", "tags.OwnerContact", "agentName", "agentVersion",
          "host.id", "collector.name"
        ]
      }
    ) {
      results(cursor: $cursor) {
        entities {
          account {
            id
            name
          }
          ... on InfrastructureHostEntityOutline {
            guid
            tags {
              key
              values
            }
          }
        }
        nextCursor
      }
    }
  }
}
"""

EXPECTED_TAGS = [
    "account", "accountId", "aws.accountId", "tags.ASV", "tags.BA",
    "owner_contact", "tags.OwnerContact", "agentName", "agentVersion",
    "host.id", "collector.name"
]

def fetch_entities():
    cursor = None
    all_entities = []

    while True:
        payload = {
            "query": QUERY,
            "variables": {"cursor": cursor}
        }

        try:
            response = requests.post(API_URL, headers=HEADERS, json=payload)
            response.raise_for_status()
        except requests.RequestException as e:
            print(f"⚠️ Request failed: {e}")
            break

        data = response.json()
        results = data.get("data", {}).get("actor", {}).get("entitySearch", {}).get("results", {})
        entities = results.get("entities", [])
        cursor = results.get("nextCursor")

        for entity in entities:
            row = {
                "account_id": entity.get("account", {}).get("id"),
                "account_name": entity.get("account", {}).get("name"),
                "guid": entity.get("guid")
            }

            tags = {k: None for k in EXPECTED_TAGS}
            for tag in entity.get("tags", []):
                key = tag.get("key")
                values = tag.get("values")
                if key in tags:
                    tags[key] = values[0] if values else None

            row.update(tags)
            all_entities.append(row)

        if not cursor:
            break

    return all_entities

def save_to_csv(rows, filename="infra_hosts_filtered.csv"):
    headers = ["account_id", "account_name", "guid"] + EXPECTED_TAGS
    with open(filename, mode="w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=headers)
        writer.writeheader()
        writer.writerows(rows)

    print(f"✅ Saved {len(rows)} host records to {filename}")

if __name__ == "__main__":
    entities = fetch_entities()
    save_to_csv(entities)