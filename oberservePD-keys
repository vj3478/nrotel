#!/usr/bin/env python3
"""
List Observe Shared Actions (channel actions) that point to PagerDuty.

Setup:
  export OBSERVE_API_BASE="https://<your-observe-api-host>"  # e.g., https://api.observeinc.com (confirm in your docs)
  export OBSERVE_API_TOKEN="obsv_xxx"                         # API token from Observe
  export OBSERVE_ACTIONS_PATH="/v1/channel-actions"           # Path to the Channel Action LIST endpoint from your API ref

Run:
  python observe_list_pagerduty_actions.py > pd_observe_actions.csv
"""

import csv
import os
import sys
import time
import urllib.parse
import requests

BASE = os.getenv("OBSERVE_API_BASE", "").rstrip("/")
TOKEN = os.getenv("OBSERVE_API_TOKEN", "")
ACTIONS_PATH = os.getenv("OBSERVE_ACTIONS_PATH", "/v1/channel-actions")  # adjust to your API doc
PAGE_SIZE = int(os.getenv("PAGE_SIZE", "200"))

if not BASE or not TOKEN:
    print("ERROR: Set OBSERVE_API_BASE and OBSERVE_API_TOKEN env vars.", file=sys.stderr)
    sys.exit(1)

SESSION = requests.Session()
SESSION.headers.update({
    "Authorization": f"Bearer {TOKEN}",
    "Accept": "application/json",
    "User-Agent": "observe-pd-audit/1.0"
})

def list_channel_actions():
    """
    Generator yielding channel actions.
    Supports naive 'page/next' styles if the API provides pagination hints.
    If your API uses cursor params (e.g., ?limit=&cursor=), adapt below.
    """
    url = f"{BASE}{ACTIONS_PATH}"
    params = {"limit": PAGE_SIZE}
    while True:
        r = SESSION.get(url, params=params, timeout=30)
        r.raise_for_status()
        data = r.json()

        # Expect a list of actions; adjust keys based on your API shape.
        items = data if isinstance(data, list) else data.get("items") or data.get("results") or []
        for item in items:
            yield item

        # Handle pagination if present (common fields: next, nextPageToken, links.next)
        next_url = data.get("next") or data.get("nextPage") or (data.get("links") or {}).get("next")
        if not next_url:
            break
        # Some APIs return absolute next links; others return cursors. Support both.
        if next_url.startswith("http"):
            url, params = next_url, {}
        else:
            params = {"cursor": next_url}
        time.sleep(0.2)

def is_pagerduty_webhook(action):
    """
    Heuristic: webhook actions whose URL host contains events.pagerduty.com.
    Adapt 'kind'/'type'/'config' keys based on your API’s schema.
    """
    kind = (action.get("type") or action.get("kind") or "").lower()
    if "webhook" not in kind:
        return False

    # Common places a webhook URL might live:
    url = (
        action.get("url")
        or (action.get("config") or {}).get("url")
        or (action.get("destination") or {}).get("url")
    )
    if not url:
        return False

    host = urllib.parse.urlparse(url).hostname or ""
    return "events.pagerduty.com" in host.lower()

def summarize(action):
    return {
        "name": action.get("name") or action.get("summary") or "",
        "id": action.get("id") or action.get("uuid") or "",
        "kind": action.get("type") or action.get("kind") or "",
        "webhook_url": (
            action.get("url")
            or (action.get("config") or {}).get("url")
            or (action.get("destination") or {}).get("url")
            or ""
        ),
        "description": action.get("description") or "",
    }

def main():
    rows = [summarize(a) for a in list_channel_actions() if is_pagerduty_webhook(a)]
    writer = csv.DictWriter(sys.stdout, fieldnames=["name", "id", "kind", "webhook_url", "description"])
    writer.writeheader()
    for row in rows:
        writer.writerow(row)

if __name__ == "__main__":
    main()