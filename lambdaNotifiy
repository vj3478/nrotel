app/lambda_handler.py


import logging
from app.docker_checker import get_new_tags
from app.sns_notifier import send_sns_notification
from app.jenkins_trigger import trigger_jenkins

logger = logging.getLogger()
logger.setLevel(logging.INFO)

def lambda_handler(event, context=None):
    try:
        changes = get_new_tags()
        if not changes:
            logger.info("No new tags found today.")
            return {"status": "No new tags"}

        send_sns_notification(changes)
        trigger_jenkins()
        return {"status": "Notifications sent", "changes": changes}
    except Exception as e:
        logger.exception("Error in Lambda execution")
        raise



