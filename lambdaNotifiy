import boto3
import logging
from app.config import SNS_TOPIC_ARN

logger = logging.getLogger()

def send_sns_notification(image_changes):
    if not SNS_TOPIC_ARN:
        raise ValueError("SNS_TOPIC_ARN not set")

    client = boto3.client("sns")
    message = "\n".join(
        [f"{img}: {', '.join(tags)}" for img, tags in image_changes.items()]
    )
    subject = "🚀 New Docker Tags Detected"
    response = client.publish(
        TopicArn=SNS_TOPIC_ARN,
        Subject=subject,
        Message=message
    )
    logger.info(f"SNS Notification sent: {response}")



