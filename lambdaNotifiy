import requests
import logging
import datetime
import time

logger = logging.getLogger()
DOCKER_IMAGES = [
    "newrelic/synthetics-job-manager",
    "newrelic/synthetics-ping-runtime",
    "newrelic/synthetics-node-browser-runtime",
    "newrelic/synthetics-node-api-runtime",
]

MAX_RETRIES = 3

def fetch_today_tags(image):
    url = f"https://hub.docker.com/v2/repositories/{image}/tags?page_size=100"
    retries = 0

    while retries < MAX_RETRIES:
        try:
            response = requests.get(url, timeout=10)
            response.raise_for_status()
            tags = response.json().get("results", [])
            
            today_utc = datetime.datetime.utcnow().date()
            new_tags = [
                tag["name"] for tag in tags
                if tag["name"] != "latest" and
                   "last_updated" in tag and
                   datetime.datetime.fromisoformat(tag["last_updated"].replace("Z", "+00:00")).date() == today_utc
            ]
            return new_tags
        except Exception as e:
            logger.warning(f"Retry {retries+1} for {image} failed: {e}")
            retries += 1
            time.sleep(2 ** retries)

    raise Exception(f"Failed to fetch tags for {image} after {MAX_RETRIES} retries")

def get_new_tags():
    new_tags = {}
    for image in DOCKER_IMAGES:
        today_tags = fetch_today_tags(image)
        if today_tags:
            new_tags[image] = today_tags
    return new_tags

