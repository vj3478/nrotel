app/jenkins_trigger.py

import logging
import requests
from app.config import JENKINS_URL, JENKINS_TOKEN

logger = logging.getLogger()

def trigger_jenkins():
    if not (JENKINS_URL and JENKINS_TOKEN):
        raise ValueError("Missing Jenkins config")

    url = f"{JENKINS_URL}?token={JENKINS_TOKEN}"
    try:
        response = requests.post(url)
        response.raise_for_status()
        logger.info("Jenkins triggered successfully.")
    except Exception as e:
        logger.exception("Failed to trigger Jenkins")
        raise



