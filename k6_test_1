import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  vus: 5,
  duration: '30s',
};

export default function () {
  const res = http.get('https://test.k6.io');

  check(res, {
    'status is 200': (r) => r.status === 200,
  });

  sleep(1);
}


docker run --rm \
  -v "$(pwd):/scripts" \
  -e K6_BROWSER_HEADLESS=true \
  custom-k6-browser-observe run /scripts/script.js \
  --out experimental-prometheus-rw \
  --tag testid=k6-browser \
  --log-output=stdout \
  --env K6_PROMETHEUS_RW_SERVER_URL=https://$OBSERVE_CUSTOMER_ID.collect.observeinc.com/v1/prometheus/remote_write \
  --env K6_PROMETHEUS_RW_BEARER_TOKEN=$OBSERVE_TOKEN

