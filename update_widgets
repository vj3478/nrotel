update dahsboard function

import asyncio
from more_itertools import chunked  # install via pip if needed

MAX_RETRIES = 3
RETRY_DELAY = 2

async def update_dashboard(
    dashboard: Dict[str, Any],
    batch: List[Dict[str, Any]],
    session: aiohttp.ClientSession
) -> None:
    """
    Extracts valid widgets and updates them in batches of 25.
    """
    valid_widgets = extract_valid_widgets(batch)
    dashboard_id = dashboard["guid"]

    if not valid_widgets:
        logging.info(f"ℹ️ No valid widgets to update for dashboard {dashboard_id}")
        return

    for widget_group in chunked(valid_widgets, 25):
        for attempt in range(MAX_RETRIES):
            try:
                await update_dashboard_widgets(dashboard_id, widget_group, session)
                logging.info(f"✅ Updated {len(widget_group)} widgets in dashboard {dashboard_id}")
                break
            except Exception as e:
                logging.warning(f"⏳ Retry {attempt + 1} failed for dashboard {dashboard_id}: {e}")
                await asyncio.sleep(RETRY_DELAY)
        else:
            logging.error(f"❌ All retries failed for dashboard {dashboard_id} group of {len(widget_group)} widgets")

