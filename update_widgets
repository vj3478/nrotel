update dashboard widgets


import aiohttp

async def update_dashboard_widgets(dashboard_id: str, widgets: List[Dict[str, Any]], session: aiohttp.ClientSession):
    """
    Sends the widget update mutation for up to 25 widgets in one call.
    """
    payload = {
        "query": UPDATE_WIDGETS_MUTATION,
        "variables": {
            "dashboardId": dashboard_id,
            "widgets": widgets
        }
    }

    async with session.post("https://api.newrelic.com/graphql", json=payload) as resp:
        resp_json = await resp.json()
        if "errors" in resp_json:
            raise Exception(f"GraphQL update error: {resp_json['errors']}")
        return resp_json["data"]



