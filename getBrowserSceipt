import os
import requests
import json
from pathlib import Path

NERDGRAPH_ENDPOINT = "https://api.newrelic.com/graphql"
API_KEY = os.getenv("NEW_RELIC_API_KEY")

if not API_KEY:
    raise RuntimeError("NEW_RELIC_API_KEY environment variable not set")

HEADERS = {
    "Content-Type": "application/json",
    "API-Key": API_KEY
}

QUERY = """
query GetSyntheticScript($guid: EntityGuid!) {
  actor {
    entity(guid: $guid) {
      ... on SyntheticMonitorEntity {
        name
        monitorType
        script {
          text
        }
      }
    }
  }
}
"""

def download_browser_script(monitor_guid, output_dir="synthetics_scripts"):
    payload = {
        "query": QUERY,
        "variables": {
            "guid": monitor_guid
        }
    }

    response = requests.post(
        NERDGRAPH_ENDPOINT,
        headers=HEADERS,
        json=payload,
        timeout=30
    )
    response.raise_for_status()

    data = response.json()

    if "errors" in data:
        raise RuntimeError(json.dumps(data["errors"], indent=2))

    entity = data["data"]["actor"]["entity"]

    if not entity or not entity.get("script"):
        raise RuntimeError("No script found for this monitor (is it a scripted browser monitor?)")

    script_text = entity["script"]["text"]
    monitor_name = entity["name"].replace(" ", "_")

    Path(output_dir).mkdir(parents=True, exist_ok=True)
    file_path = Path(output_dir) / f"{monitor_name}.js"

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(script_text)

    print(f"✅ Script downloaded: {file_path}")
    return file_path


if __name__ == "__main__":
    MONITOR_GUID = "REPLACE_WITH_MONITOR_GUID"
    download_browser_script(MONITOR_GUID)