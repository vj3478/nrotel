import os
import requests
from pathlib import Path

API_KEY = os.getenv("NEW_RELIC_API_KEY")
NERDGRAPH = "https://api.newrelic.com/graphql"
SYNTHETICS_API = "https://synthetics.newrelic.com/synthetics/api/v3"

HEADERS = {
    "API-Key": API_KEY,
    "Content-Type": "application/json"
}

def get_monitor_id(guid):
    query = """
    query ($guid: EntityGuid!) {
      actor {
        entity(guid: $guid) {
          ... on SyntheticMonitorEntity {
            monitorId
            name
            monitorType
          }
        }
      }
    }
    """
    r = requests.post(
        NERDGRAPH,
        headers=HEADERS,
        json={"query": query, "variables": {"guid": guid}}
    )
    r.raise_for_status()
    entity = r.json()["data"]["actor"]["entity"]

    if entity["monitorType"] != "SCRIPT_BROWSER":
        raise RuntimeError("Not a scripted browser monitor")

    return entity["monitorId"], entity["name"]

def download_browser_script(guid, out_dir="scripts"):
    monitor_id, name = get_monitor_id(guid)

    r = requests.get(
        f"{SYNTHETICS_API}/monitors/{monitor_id}/script",
        headers=HEADERS
    )
    r.raise_for_status()

    Path(out_dir).mkdir(exist_ok=True)
    file_path = Path(out_dir) / f"{name.replace(' ', '_')}.js"

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(r.text)

    print(f"✅ Script downloaded: {file_path}")

if __name__ == "__main__":
    download_browser_script("REPLACE_WITH_GUID")