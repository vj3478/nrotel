def export_entities_to_csv(json_data, output_csv_file):
    # Extract entities
    entities = json_data.get("data", {}).get("actor", {}).get("entitySearch", {}).get("results", {}).get("entities", [])
    
    # Define expected tag keys
    expected_keys = [
        "account", "accountId", "agentName", "awsAccountId", 
        "agentVersion", "clusterName"
    ]

    # Prepare rows
    rows = []
    for entity in entities:
        row = {
            "account_id": entity.get("account", {}).get("id"),
            "account_name": entity.get("account", {}).get("name"),
            "guid": entity.get("guid"),
            "name": entity.get("name")
        }

        # Initialize tags
        tag_map = {k: None for k in expected_keys}

        for tag in entity.get("tags", []):
            key = tag.get("key")
            values = tag.get("values", [])
            if key in tag_map:
                tag_map[key] = values[0] if values else None

        # Merge tags into row
        row.update(tag_map)
        rows.append(row)

    # Define CSV headers
    headers = ["account_id", "account_name", "guid", "name"] + expected_keys

    # Write to CSV
    with open(output_csv_file, "w", newline='') as f:
        writer = csv.DictWriter(f, fieldnames=headers)
        writer.writeheader()
        writer.writerows(rows)

    print(f"Exported to {output_csv_file}")


