#!/usr/bin/env bash
set -euo pipefail

# Required inputs
: "${AWS_REGION:?AWS_REGION is required}"
: "${AWS_SECRET_NAME:?AWS_SECRET_NAME is required}"
: "${LOGIN_URL:?LOGIN_URL is required}"

# Optional if username is stored separately
: "${LOGIN_USERNAME:=}"

# Fetch secret using current AWS CLI identity / role
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$AWS_SECRET_NAME" \
  --query SecretString \
  --output text)

# If secret is plain text, use it directly as password.
# If secret is JSON, extract username/password from it.
LOGIN_PASSWORD="$SECRET_JSON"

if echo "$SECRET_JSON" | jq -e . >/dev/null 2>&1; then
  SECRET_USERNAME=$(echo "$SECRET_JSON" | jq -r '.username // empty')
  SECRET_PASSWORD=$(echo "$SECRET_JSON" | jq -r '.password // empty')

  if [ -n "$SECRET_USERNAME" ]; then
    LOGIN_USERNAME="$SECRET_USERNAME"
  fi

  if [ -n "$SECRET_PASSWORD" ]; then
    LOGIN_PASSWORD="$SECRET_PASSWORD"
  fi
fi

if [ -z "${LOGIN_USERNAME}" ]; then
  echo "ERROR: LOGIN_USERNAME is empty. Either pass LOGIN_USERNAME or store username in the secret JSON."
  exit 1
fi

if [ -z "${LOGIN_PASSWORD}" ]; then
  echo "ERROR: LOGIN_PASSWORD is empty after retrieving secret."
  exit 1
fi

export LOGIN_USERNAME
export LOGIN_PASSWORD
export LOGIN_URL

k6 run login-browser.js
