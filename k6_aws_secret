import { browser } from 'k6/browser';
import { check } from 'k6';
import exec from 'k6/execution';

export const options = {
  scenarios: {
    ui_login: {
      executor: 'shared-iterations',
      vus: 1,
      iterations: 1,
      options: {
        browser: {
          type: 'chromium',
        },
      },
    },
  },
};

export default async function () {
  const loginUrl = __ENV.LOGIN_URL;
  const username = __ENV.LOGIN_USERNAME;
  const password = __ENV.LOGIN_PASSWORD;

  if (!loginUrl) exec.test.abort('LOGIN_URL is required');
  if (!username) exec.test.abort('LOGIN_USERNAME is required');
  if (!password) exec.test.abort('LOGIN_PASSWORD is required');

  const page = await browser.newPage();

  try {
    await page.goto(loginUrl, { waitUntil: 'networkidle' });

    // Update selectors to match your page
    await page.locator('input[name="username"]').fill(username);
    await page.locator('input[name="password"]').fill(password);
    await page.locator('button[type="submit"]').click();

    // Update this to match your successful post-login URL or page element
    await page.waitForURL(/dashboard|home|landing/i, { timeout: 15000 });

    await check(page, {
      'login succeeded': async (p) => (await p.title()) !== '',
    });
  } finally {
    await page.close();
  }
}


