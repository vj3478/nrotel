import { browser } from 'k6/browser';
import { check } from 'k6';
import exec from 'k6/execution';
import {
  AWSConfig,
  SecretsManagerClient,
} from 'https://jslib.k6.io/aws/0.14.0/secrets-manager.js';

// ---------- k6 browser config ----------
export const options = {
  scenarios: {
    ui_login: {
      executor: 'shared-iterations',
      vus: 1,
      iterations: 1,
      options: {
        browser: {
          type: 'chromium',
        },
      },
    },
  },
};

// ---------- AWS Secrets Manager client ----------
const awsConfig = new AWSConfig({
  region: __ENV.AWS_REGION,
  accessKeyId: __ENV.AWS_ACCESS_KEY_ID,
  secretAccessKey: __ENV.AWS_SECRET_ACCESS_KEY,
  sessionToken: __ENV.AWS_SESSION_TOKEN, // optional
});

const secretsClient = new SecretsManagerClient(awsConfig);

// ---------- setup: fetch secret once ----------
export async function setup() {
  const secretName = __ENV.AWS_SECRET_NAME;
  if (!secretName) {
    exec.test.abort('AWS_SECRET_NAME env var is required');
  }

  const secret = await secretsClient.getSecret(secretName);

  if (!secret || !secret.secret) {
    exec.test.abort(`Secret not found or empty: ${secretName}`);
  }

  let username = __ENV.LOGIN_USERNAME;
  let password = secret.secret;

  // If your secret is JSON like:
  // {"username":"myuser","password":"mypassword"}
  // this will extract password from it.
  try {
    const parsed = JSON.parse(secret.secret);
    username = parsed.username || username;
    password = parsed.password || password;
  } catch (e) {
    // secret is plain text, so use as password directly
  }

  if (!username) {
    exec.test.abort(
      'LOGIN_USERNAME env var is required unless username is inside the secret JSON'
    );
  }

  return {
    username,
    password,
  };
}

// ---------- browser test ----------
export default async function (data) {
  const page = await browser.newPage();

  try {
    await page.goto(__ENV.LOGIN_URL, { waitUntil: 'networkidle' });

    // Update these selectors to match your app
    await page.locator('input[name="username"]').fill(data.username);
    await page.locator('input[name="password"]').fill(data.password);
    await page.locator('button[type="submit"]').click();

    // Change this to something that proves login succeeded
    await page.waitForURL(/dashboard|home|landing/i, { timeout: 15000 });

    check(page, {
      'logged in successfully': async (p) =>
        (await p.title()) !== null,
    });
  } finally {
    await page.close();
  }
}