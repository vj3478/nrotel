import re

def clean_and_extract_span_columns(nrql_query: str):
    # Normalize whitespace and lowercase 'from span' for consistency
    query = re.sub(r'\s+', ' ', nrql_query.strip(), flags=re.MULTILINE)
    
    # Find the portion after "FROM Span"
    match = re.search(r'from\s+span\b(.*?)((group\s+by|select|from|limit|order\s+by)|$)', query, re.IGNORECASE)
    if not match:
        return []

    span_block = match.group(1)

    # Fix multiple WHERE clauses: keep only the first 'WHERE', replace others with AND
    span_block_fixed = re.sub(r'\bwhere\b', 'WHERE', span_block, count=1, flags=re.IGNORECASE)
    span_block_fixed = re.sub(r'\bwhere\b', 'AND', span_block_fixed, flags=re.IGNORECASE)

    # Extract the WHERE clause
    where_match = re.search(r'\bWHERE\b\s+(.*)', span_block_fixed, re.IGNORECASE)
    if not where_match:
        return []

    where_clause = where_match.group(1)

    # Split on AND/OR and extract column names
    conditions = re.split(r'\bAND\b|\bOR\b', where_clause, flags=re.IGNORECASE)
    columns = set()

    for cond in conditions:
        left_side = re.split(r'=|!=|<>|IN|NOT IN|LIKE|>|<', cond, maxsplit=1)[0].strip()
        column_match = re.match(r'[a-zA-Z_][\w\.]*', left_side)
        if column_match:
            columns.add(column_match.group(0))

    return sorted(columns)

