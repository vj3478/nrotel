# --- Configuration ---
API_KEY = "YOUR_NEW_RELIC_API_KEY"
ACCOUNT_IDS = [1234567, 7654321]  # Replace with your real account IDs
CSV_OUTPUT = "nrql_combined_results.csv"

# --- NRQL Query ---
NRQL_QUERY = """
FROM Span 
SELECT count(*) 
WHERE (telemetry.sdk.name IS NOT NULL OR telemetry.sdk.version IS NOT NULL) 
  AND aws.version IS NULL 
  AND instrumentation.provider = 'opentelemetry' 
  AND aws.lambda.arn IS NULL 
FACET service.name, Component, owner 
LIMIT MAX
"""

# --- GraphQL Query Template ---
GRAPHQL_QUERY = """
query($accountId: Int!, $nrql: String!) {
  actor {
    account(id: $accountId) {
      name
      nrql(query: $nrql) {
        results
        metadata {
          eventTypes
          facets
        }
      }
    }
  }
}
"""

# --- Headers ---
HEADERS = {
    "Api-Key": API_KEY,
    "Content-Type": "application/json"
}

@retry(
    stop=stop_after_attempt(3),
    wait=wait_exponential(multiplier=1, min=2, max=10),
    retry=retry_if_exception_type((requests.exceptions.RequestException, KeyError)),
    reraise=True
)
def run_nrql_query(account_id: int, nrql: str) -> List[dict]:
    payload = {
        "query": GRAPHQL_QUERY,
        "variables": {
            "accountId": account_id,
            "nrql": nrql
        }
    }

    logging.info(f"📤 Sending query to account {account_id}")
    response = requests.post("https://api.newrelic.com/graphql", headers=HEADERS, json=payload)
    response.raise_for_status()
    data = response.json()

    account_name = data["data"]["actor"]["account"]["name"]
    results = data["data"]["actor"]["account"]["nrql"]["results"]
    for row in results:
        row["account_id"] = account_id
        row["account_name"] = account_name
    logging.info(f"✅ Retrieved {len(results)} results for account {account_id} ({account_name})")
    return results

def export_combined_csv(all_results: List[dict], output_filename: str):
    if not all_results:
        logging.warning("⚠️ No results returned from any account.")
        return

    # Collect all possible keys
    keys_set = set()
    for row in all_results:
        keys_set.update(row.keys())
    keys = sorted(keys_set)

    try:
        with open(output_filename, mode="w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=keys)
            writer.writeheader()
            for row in all_results:
                writer.writerow(row)
        logging.info(f"✅ Combined results saved to '{output_filename}'")
    except Exception as e:
        logging.exception(f"❌ Failed to write results to CSV: {e}")

def main():
    all_results = []
    for account_id in ACCOUNT_IDS:
        try:
            logging.info(f"🔍 Running NRQL query for account {account_id}...")
            results = run_nrql_query(account_id, NRQL_QUERY)
            all_results.extend(results)
        except Exception as e:
            logging.error(f"❌ Failed after retries for account {account_id}: {e}")

    export_combined_csv(all_results, CSV_OUTPUT)

if __name__ == "__main__":
    main()

