import re
from typing import List, Dict

def has_matching_app(nrql_query: str, allowed_apps: Dict[str, List[str]]) -> bool:
    def normalize(s: str) -> str:
        return re.sub(r'[^a-zA-Z0-9]', '', s).lower()

    normalized_allowed = {
        "service_or_entity": [normalize(v) for v in allowed_apps.get("service_or_entity", [])],
        "entity.guid": [normalize(v) for v in allowed_apps.get("entity.guid", [])]
    }

    field_aliases = {
        "service.name": "service_or_entity",
        "entity.name": "service_or_entity",
        "entity.guid": "entity.guid"
    }

    fields_to_extract = field_aliases.keys()
    pattern_fields = "|".join(re.escape(f) for f in fields_to_extract)

    # Match = or LIKE
    simple_pattern = rf"""({pattern_fields})\s*(=|LIKE)\s*(['"])(.*?)(?<!\\)\3"""
    for match in re.finditer(simple_pattern, nrql_query, flags=re.IGNORECASE | re.DOTALL):
        field, operator, raw_value = match.group(1), match.group(2), match.group(4)
        value = raw_value.encode().decode('unicode_escape')
        norm_val = normalize(value)
        target_key = field_aliases[field]

        for allowed in normalized_allowed.get(target_key, []):
            if '%' in value:
                prefix = normalize(value.split('%')[0])
                if allowed.startswith(prefix):
                    return True
            elif norm_val == allowed:
                return True

    # Match IN (...)
    in_pattern = rf"""({pattern_fields})\s+IN\s*\(\s*([^)]+)\)"""
    for match in re.finditer(in_pattern, nrql_query, flags=re.IGNORECASE):
        field, raw_values = match.group(1), match.group(2)
        target_key = field_aliases[field]
        values = re.findall(r"""(['"])(.*?)(?<!\\)\1""", raw_values)

        for _, val in values:
            unescaped = val.encode().decode('unicode_escape')
            norm_val = normalize(unescaped)
            for allowed in normalized_allowed.get(target_key, []):
                if '%' in unescaped:
                    prefix = normalize(unescaped.split('%')[0])
                    if allowed.startswith(prefix):
                        return True
                elif norm_val == allowed:
                    return True

    return False

