   import asyncio
import logging
from typing import List, Dict, Any
from collections import Counter

RETRY_DELAY = 2
MAX_RETRIES = 3

# Module-level alias counter (shared across batches)
global_alias_counter = 0

async def validate_batch(current_batch: List[Dict[str, Any]], session) -> List[str]:
    global global_alias_counter

    if not session or session.closed:
        raise ValueError("Invalid or closed session")

    total_results = ["pending"] * len(current_batch)

    for attempt in range(MAX_RETRIES):
        pending_indexes = [i for i, r in enumerate(total_results) if r == "pending"]
        if not pending_indexes:
            break

        alias_map = {}
        query_parts = []

        for i in pending_indexes:
            row = current_batch[i]
            alias = f"q{global_alias_counter}"
            global_alias_counter += 1
            alias_map[alias] = i

            query = row["query"].replace('"', '\\"').replace("\n", " ").strip()
            account_id = row["accountIds"]

            query_parts.append(f"""
            {alias}: actor {{
              nrql(
                accounts: {account_id}
                query: "{query}"
                timeout: 60
              ) {{
                results
              }}
            }}
            """)

        if not query_parts:
            logging.error("❌ No queries to validate.")
            total_results = ["failed"] * len(current_batch)
            break

        full_query = "query {\n" + "\n".join(query_parts) + "\n}"
        logging.info(f"📤 Sending validation query (length: {len(full_query)})")

        graphql_response = await graphql_query(session, {"query": full_query})
        data = graphql_response.get("data", {})
        if not data:
            logging.warning("⚠️ No data in response. Retrying...")
            await asyncio.sleep(RETRY_DELAY)
            continue

        error_paths = {e["path"][0] for e in graphql_response.get("errors", [])} if "errors" in graphql_response else set()

        for alias, i in alias_map.items():
            if alias in error_paths:
                total_results[i] = "invalid"
                logging.warning(f"❌ Alias {alias} → invalid")
                continue

            alias_node = data.get(alias)
            if not alias_node:
                total_results[i] = "failed"
                logging.error(f"❌ Alias {alias} → missing")
                continue

            alias_data = alias_node.get("nrql", {})
            result_block = alias_data.get("results")

            if result_block is None:
                total_results[i] = "timeout"
                logging.warning(f"⚠️ Alias {alias} → timeout (no result block)")
                continue

            if isinstance(result_block, list) and len(result_block) == 0:
                total_results[i] = "no_data"
                continue

            if isinstance(result_block, list):
                first_row = result_block[0]
                if isinstance(first_row, dict):
                    # ✅ Updated: ignore structural keys
                    values = [v for k, v in first_row.items() if k not in {"beginTimeSeconds", "endTimeSeconds", "inspectedCount"}]
                    if not values or all(v is None for v in values):
                        total_results[i] = "no_data"
                    elif all(v == 0 or v == 0.0 for v in values):
                        total_results[i] = "result_0"
                    else:
                        total_results[i] = "success"
                    continue

            total_results[i] = "failed"

        # Mark leftover pending results as timeout
        for i, result in enumerate(total_results):
            if result == "pending":
                total_results[i] = "timeout"

        # ✅ Optional: log summary
        result_counts = Counter(total_results)
        summary = ", ".join(f"{k}: {v}" for k, v in result_counts.items())
        logging.info(f"✅ Final validation summary: {summary}")

    return total_results

