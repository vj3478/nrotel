import asyncio
import aiohttp
import re


def is_nested_span_query(nrql):
    nrql_cleaned = re.sub(r'\s+', ' ', nrql.lower())
    return nrql_cleaned.count('from span') > 1


def extract_from_span_blocks(nrql):
    span_blocks = []
    for match in re.finditer(r'(from\s+span(?:.|\n)*?)(?=from\s+|$)', nrql, flags=re.IGNORECASE):
        span_blocks.append(match.group(0))
    return span_blocks


def replace_span_blocks_with_mapping(nrql, mapping):
    def replace_entire_block(block):
        updated_block = block
        for key, replacement in mapping.items():
            # Escape special characters in key to safely use in regex
            pattern = re.escape(key)
            updated_block = re.sub(pattern, replacement, updated_block, flags=re.IGNORECASE)
        return updated_block

    updated = nrql
    for block in extract_from_span_blocks(nrql):
        new_block = replace_entire_block(block)
        updated = updated.replace(block, new_block)
    return updated

