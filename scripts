import re

def update_span_query_columns(nrql_query, mapper):
    """
    Updates specific column names and the 'FROM Span' clause within an NRQL query
    based on a provided mapper, specifically the mapping under the 'Span' key.
    Handles single and nested NRQL queries, including those starting with
    'FROM' or 'SELECT', correctly handles special characters in mapper keys,
    and supports multiline queries. Ensures only whole words are replaced for
    column names but replaces phrases like 'FROM Span' directly.

    Args:
        nrql_query (str): The original NRQL query string (can be multiline).
        mapper (dict): A dictionary containing mapping configurations.
                       Expected structure: {'Span': {'old_value': 'new_value', ...}}
                       The 'Span' dictionary contains the specific replacements
                       to apply to NRQL queries originating from 'FROM Span'.

    Returns:
        str: The NRQL query string with specified column names and the 'FROM Span'
             clause (if applicable and mapped) updated according to the mapper.
             Returns the original query if inputs are invalid or no 'Span' mapping exists.
    """
    if not nrql_query or not isinstance(nrql_query, str) or not mapper or not isinstance(mapper, dict):
        return nrql_query # Return original if inputs are invalid

    span_mapper = mapper.get("Span")

    if not span_mapper or not isinstance(span_mapper, dict):
        return nrql_query # No 'Span' mapping found or it's invalid

    modified_query = nrql_query

    # Create a mutable copy of the mapper to handle the special "From Span" key separately
    span_mapper_copy = span_mapper.copy()

    # --- Handle the special "From Span" replacement first (case-insensitive and multiline) ---
    # Check if "From Span" is a key in the mapper and apply its replacement
    # Find the actual key in the mapper that matches "From Span" case-insensitively
    from_span_old_value = "From Span"
    from_span_key_in_mapper = None
    for key in span_mapper_copy:
        if key.lower() == from_span_old_value.lower():
            from_span_key_in_mapper = key
            break

    if from_span_key_in_mapper:
        from_span_new_value = span_mapper_copy.pop(from_span_key_in_mapper)
        # Use re.sub with IGNORECASE and DOTALL flags for "From Span"
        # Construct pattern that accounts for potential whitespace variations around "From" and "Span"
        pattern = re.compile(r"from\s+span", re.IGNORECASE | re.DOTALL)
        # Use the compiled pattern, do not pass flags to re.sub
        modified_query = re.sub(pattern, from_span_new_value, modified_query)


    # --- Handle other column/value replacements with word boundaries (case-insensitive and multiline) ---
    # Sort remaining keys (old column names/values) by length in descending order
    # to handle cases where one name/value is a substring of another.
    sorted_old_values = sorted(span_mapper_copy.keys(), key=len, reverse=True)

    for old_value in sorted_old_values:
        new_value = span_mapper_copy[old_value]

        # Escape special characters in the old value for regex
        escaped_old_value = re.escape(old_value)

        # Create a regex pattern to match the escaped old value
        # \b ensures word boundaries, so 'id' doesn't match part of 'instance.id'
        # Use a raw string for the pattern
        # Perform case-insensitive replacement for robustness, adjust if strict case is needed
        # Need to be careful with "count(*)" - \b around * is not correct
        if old_value == "count(*)":
             pattern = r"count\(\*\)" # Specific pattern for count(*)
        elif old_value == "duration.ms*1000":
             pattern = r"duration\.ms\*1000" # Specific pattern for duration.ms*1000, escaping . and *
        else:
             pattern = r"\b" + escaped_old_value + r"\b"

        # Use re.sub with IGNORECASE and DOTALL flags
        modified_query = re.sub(pattern, str(new_value), modified_query, flags=re.IGNORECASE | re.DOTALL) # Convert new_value to string


    return modified_query

