var request = require('request');

var options = {
  method: 'GET',
  url: 'https://safadsfd.com?customerReferenceId=ssafdsa', // Replace with your actual URL
  headers: {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'Api-Key': 'ENROLLMENTAPP',
    'country-code': 'US',
    'Channel-Type': 'Web',
    'Client-Correlation-Id': 'saffds-sdfdsa-sd',
    'Cookie': 'AWSALB=safdsafdsafds; AWSALBCORS=safdsafdsafds; JSESSIONID=dsfdsafdsaas',
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119 Safari/537.36'
  },
  timeout: 10000 // timeout in milliseconds
};

console.log("🔍 Sending request to:", options.url);

request(options, function (error, response, body) {
  if (error) {
    console.error("❌ Request failed:", error);
    return;
  }

  console.log("✅ Status Code:", response && response.statusCode);

  try {
    const json = JSON.parse(body); // Attempt to parse response as JSON
    console.log("📄 JSON Response:\n", JSON.stringify(json, null, 2)); // Pretty-print JSON
  } catch (e) {
    console.warn("⚠️ Response is not valid JSON. Printing raw body:");
    console.log(body); // Fallback: print raw response
  }
});