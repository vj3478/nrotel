#!/usr/bin/env bash
set -euo pipefail

## ===== CONFIG =====
ARTIFACTORY_REGISTRY="artifactory.local"
ARTIFACTORY_NAMESPACE="newrelic"
ARTIFACTORY_USER="myuser"
ARTIFACTORY_PASSWORD="mypassword"
LOOKBACK_HOURS=24

LABEL_ONE="1234-itsis1234"
LABEL_TWO="1234-itsisa1234"
LABEL_THREE="email-ss.com"

GOLDEN_BASE="artifactory.local.com/languages/java:17-ubuntu24.04-runner-250417"

SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:docker-builds"
AWS_REGION="us-east-1"

DOCKERHUB_ORG="newrelic"
IMAGES=(
  "synthetics-job-manager"
  "synthetics-ping-runtime"
  "synthetics-node-api-runtime"
  "synthetics-node-browser-runtime"
)

LOG_FILE="./build_log_$(date +%Y%m%d_%H%M%S).log"
log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOG_FILE"; }

## ===== FUNCTIONS =====
get_new_tags() {
  local image=$1
  local since_epoch=$(( $(date -u +%s) - LOOKBACK_HOURS*3600 ))
  curl -s "https://hub.docker.com/v2/repositories/${DOCKERHUB_ORG}/${image}/tags?page_size=100" |
    jq -r --argjson since "$since_epoch" '
      .results[] | select(.name != "latest") |
      select((.last_updated | sub("Z$";"") | sub("\\.[0-9]+";"") | strptime("%Y-%m-%dT%H:%M:%S") | mktime) >= $since) |
      .name' | sort -u
}

check_in_registry() {
  docker manifest inspect "$1" >/dev/null 2>&1
}

make_dockerfile() {
  local image=$1 tag=$2 dir=$3
  local needs_user_group=false
  [[ "$image" =~ job-manager|ping-runtime ]] && needs_user_group=true

  {
    echo "# syntax=docker/dockerfile:1.6"
    echo "ARG GOLDEN_BASE"
    echo "ARG BASE_IMAGE_REF"
    echo "ARG DOCKER_GID"
    $needs_user_group && echo "FROM \${GOLDEN_BASE} AS golden"
    echo "FROM \${BASE_IMAGE_REF}"
    echo "USER root"
    if $needs_user_group; then
      echo "RUN groupadd --gid \${DOCKER_GID} docker \\"
      echo " && useradd -u 2005 -g docker runuser"
      echo "COPY --from=golden /etc/passwd /etc/passwd"
      echo "COPY --from=golden /etc/shadow /etc/shadow"
      echo "COPY --from=golden /etc/group /etc/group"
    fi
    echo "ARG LABEL_ONE"
    echo "ARG LABEL_TWO"
    echo "ARG LABEL_THREE"
    echo "LABEL one=\"\${LABEL_ONE}\""
    echo "LABEL two=\"\${LABEL_TWO}\""
    echo "LABEL three=\"\${LABEL_THREE}\""
    [[ "$image" == "synthetics-ping-runtime" ]] && echo "RUN chmod 755 /data/synthetics-ping-runtime/bin/control || true"
    [[ "$image" == "synthetics-job-manager" ]] && echo "RUN chmod 755 /data/synthetics-job-manager/bin/control || true"
    $needs_user_group && echo "USER runuser"
  } > "$dir/Dockerfile"
}

send_sns() {
  [[ -z "$SNS_TOPIC_ARN" ]] && return
  aws sns publish --topic-arn "$SNS_TOPIC_ARN" --region "$AWS_REGION" --subject "$1" --message "$2" >/dev/null
}

## ===== MAIN =====
DOCKER_GID=$(getent group docker | cut -d: -f3 || true)

docker login "$ARTIFACTORY_REGISTRY" -u "$ARTIFACTORY_USER" -p "$ARTIFACTORY_PASSWORD"

built_list=()

for img in "${IMAGES[@]}"; do
  log "Checking new tags for $img..."
  tags=$(get_new_tags "$img")
  [[ -z "$tags" ]] && { log "No new tags."; continue; }
  for tag in $tags; do
    target="${ARTIFACTORY_REGISTRY}/${ARTIFACTORY_NAMESPACE}/${img}:${tag}"
    if check_in_registry "$target"; then
      log "Already exists in registry: $target"
      continue
    fi
    log "Building $target..."
    tmpdir=$(mktemp -d)
    make_dockerfile "$img" "$tag" "$tmpdir"
    docker build \
      --pull \
      --build-arg GOLDEN_BASE="$GOLDEN_BASE" \
      --build-arg BASE_IMAGE_REF="${DOCKERHUB_ORG}/${img}:${tag}" \
      --build-arg DOCKER_GID="$DOCKER_GID" \
      --build-arg LABEL_ONE="$LABEL_ONE" \
      --build-arg LABEL_TWO="$LABEL_TWO" \
      --build-arg LABEL_THREE="$LABEL_THREE" \
      -t "$target" "$tmpdir"
    docker push "$target"
    rm -rf "$tmpdir"
    built_list+=("$img:$tag")
  done
done

if (( ${#built_list[@]} > 0 )); then
  msg="Built & pushed: ${built_list[*]}"
else
  msg="No images built."
fi
log "$msg"
send_sns "Docker Build Status" "$msg"