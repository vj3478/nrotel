import requests
import json

# ---------------------------------------------------------
# CONFIG  (use the exact host you see in the browser)
# ---------------------------------------------------------
OBSERVE_BASE_URL = "https://YOUR_REAL_HOST.observeinc.com"

OBSV_USER_EMAIL = "service_account_email@example.com"
OBSV_USER_PASSWORD = "SERVICE_ACCOUNT_PASSWORD"
TOKEN_NAME = "api-monitor-reader"


# ---------------- LOGIN ----------------

def login_and_get_auth():
    """
    Call /v1/login and return (customer_id, access_key).
    """
    url = f"{OBSERVE_BASE_URL}/v1/login"
    payload = {
        "user_email": OBSV_USER_EMAIL,
        "user_password": OBSV_USER_PASSWORD,
        "tokenName": TOKEN_NAME,
    }

    resp = requests.post(url, json=payload, timeout=30)
    if resp.status_code != 200:
        raise Exception(f"Login failed ({resp.status_code}): {resp.text}")

    data = resp.json()      # e.g. {'ok': True, 'access_key': '...', 'customer_id': 1631402...}

    access_key = data.get("access_key")
    customer_id = data.get("customer_id")

    if not access_key or not customer_id:
        raise Exception(f"Login successful but access_key/customer_id missing: {data}")

    print("✅ Login successful")
    return str(customer_id), access_key


# ------------- FETCH MONITORS -------------

def fetch_all_monitors(customer_id, access_key):
    """
    Fetch all monitors, handling both:
      - [ {...}, {...} ]                 (list)
      - { "data": [..], "next_page_token": ... }  (dict with pagination)
    """
    monitors = []
    next_page = None

    # If your tenant only works with one of these formats,
    # you can hard-code the one that works and drop the other.
    auth_header = f"Bearer {customer_id} {access_key}"  # try this first
    headers = {
        "Authorization": auth_header,
        "Content-Type": "application/json",
    }

    while True:
        url = f"{OBSERVE_BASE_URL}/v1/monitors"
        if next_page:
            url += f"?page={next_page}"

        resp = requests.get(url, headers=headers, timeout=30)

        if resp.status_code == 401:
            # If this happens, try switching to "Bearer <access_key>" only
            raise Exception("❌ 401 Unauthorized: check Authorization header / host")
        if resp.status_code == 403:
            raise Exception("❌ 403 Forbidden: token lacks monitor permissions")
        if resp.status_code != 200:
            raise Exception(f"❌ API error {resp.status_code}: {resp.text}")

        data = resp.json()

        # ---- Shape 1: plain list ----
        if isinstance(data, list):
            monitors.extend(data)
            break  # no pagination if it's just a list

        # ---- Shape 2: dict with 'data' + 'next_page_token' ----
        elif isinstance(data, dict):
            monitors.extend(data.get("data", []))
            next_page = data.get("next_page_token")
            if not next_page:
                break

        else:
            raise Exception(f"Unexpected JSON type from /v1/monitors: {type(data)}")

    return monitors


# ----------------- MAIN ------------------

if __name__ == "__main__":
    try:
        print("🔐 Logging in...")
        customer_id, access_key = login_and_get_auth()

        print("📡 Fetching monitors...")
        monitors = fetch_all_monitors(customer_id, access_key)

        print(f"✅ Retrieved {len(monitors)} monitors\n")
        print(json.dumps(monitors, indent=2))

    except Exception as e:
        print(e)