# ---------------- LOGIN ----------------

def login_and_get_auth() -> (str, str):
    """
    Call /v1/login and return (customer_id, access_key).
    Matches the response you showed earlier:
      {"ok": true, "access_key": "...", "customer_id": 1631402...}
    """
    url = f"{OBSERVE_BASE_URL}/v1/login"
    payload = {
        "user_email": OBSV_USER_EMAIL,
        "user_password": OBSV_USER_PASSWORD,
        "tokenName": TOKEN_NAME,
    }

    resp = requests.post(url, json=payload, timeout=30)
    if resp.status_code != 200:
        raise Exception(f"Login failed ({resp.status_code}): {resp.text}")

    data = resp.json()
    access_key = data.get("access_key")
    customer_id = data.get("customer_id")
    if not access_key or not customer_id:
        raise Exception(f"Login succeeded but access_key/customer_id missing: {data}")

    print("✅ Login successful")
    return str(customer_id), access_key


# ------------- FETCH MONITORS -------------

def fetch_all_monitors(customer_id: str, access_key: str) -> List[Dict[str, Any]]:
    """
    Fetch all monitors from /v1/monitors.
    In your env, /v1/monitors returns a top-level LIST.
    """
    headers = {
        "Authorization": f"Bearer {customer_id} {access_key}",
        "Content-Type": "application/json",
    }

    url = f"{OBSERVE_BASE_URL}/v1/monitors"
    resp = requests.get(url, headers=headers, timeout=30)

    if resp.status_code == 401:
        raise Exception("❌ 401 Unauthorized from /v1/monitors – check Authorization header.")
    if resp.status_code == 403:
        raise Exception("❌ 403 Forbidden – service account lacks monitor permissions.")
    if resp.status_code != 200:
        raise Exception(f"❌ API error {resp.status_code}: {resp.text}")

    data = resp.json()
    if isinstance(data, list):
        return data
    elif isinstance(data, dict):
        return data.get("data") or data.get("monitors") or []
    else:
        raise Exception(f"Unexpected /v1/monitors JSON type: {type(data)}")


# --------- HELPERS TO EXTRACT FIELDS ---------

def get_monitor_id(m: Dict[str, Any]) -> str:
    return str(m.get("id") or m.get("monitor_id") or m.get("_id") or "")


def get_monitor_name(m: Dict[str, Any]) -> str:
    return str(m.get("name") or m.get("monitor_name") or "")


def get_monitor_created_by(m: Dict[str, Any]) -> str:
    return (
        m.get("created_by")
        or (m.get("meta") or {}).get("created_by")
        or (m.get("metadata") or {}).get("createdBy")
        or ""
    )


def get_monitor_status(m: Dict[str, Any]) -> str:
    if "enabled" in m:
        return "enabled" if m.get("enabled") else "disabled"
    if "disabled" in m:
        return "disabled" if m.get("disabled") else "enabled"
    return ""


def extract_actions(m: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Try common keys for notifications/actions."""
    for key in ("notifications", "actions", "notification_actions", "notificationActions"):
        v = m.get(key)
        if isinstance(v, list):
            return v
    return []


def summarize_action(act: Dict[str, Any]) -> Dict[str, str]:
    """Summarize a monitor action (shared or inline). Tweak keys after you inspect JSON."""
    action_type = (
        act.get("type")
        or act.get("action_type")
        or act.get("channel_type")
        or ""
    )

    channel = (
        act.get("channel")
        or act.get("notificationChannel")
        or act.get("integration_type")
        or action_type
        or ""
    )

    target = (
        act.get("email")
        or act.get("address")
        or act.get("url")
        or act.get("endpoint")
        or act.get("service_key")
        or ""
    )

    shared_action_id = (
        act.get("shared_action_id")
        or act.get("sharedActionId")
        or act.get("shared_action_uuid")
        or ""
    )

    is_shared = "yes" if shared_action_id else "no"

    return {
        "action_type": str(action_type),
        "action_channel": str(channel),
        "action_target": str(target),
        "shared_action_id": str(shared_action_id),
        "is_shared_action": is_shared,
    }


# ------------- MAIN EXPORT -------------

def export_monitors_with_actions(csv_path: str) -> None:
    customer_id, access_key = login_and_get_auth()

    monitors = fetch_all_monitors(customer_id, access_key)
    print(f"Fetched {len(monitors)} monitors")

    # Uncomment once to see actual JSON and adjust keys if needed
    # print(json.dumps(monitors[0], indent=2))

    rows: List[Dict[str, Any]] = []

    for m in monitors:
        mid = get_monitor_id(m)
        name = get_monitor_name(m)
        created_by = get_monitor_created_by(m)
        status = get_monitor_status(m)

        actions = extract_actions(m)

        if not actions:
            rows.append(
                {
                    "monitor_id": mid,
                    "monitor_name": name,
                    "created_by": created_by,
                    "status": status,
                    "action_type": "",
                    "action_channel": "",
                    "action_target": "",
                    "is_shared_action": "",
                    "shared_action_id": "",
                }
            )
            continue

        for act in actions:
            a = summarize_action(act)
            rows.append(
                {
                    "monitor_id": mid,
                    "monitor_name": name,
                    "created_by": created_by,
                    "status": status,
                    **a,
                }
            )

    fieldnames = [
        "monitor_id",
        "monitor_name",
        "created_by",
        "status",
        "action_type",
        "action_channel",
        "action_target",
        "is_shared_action",
        "shared_action_id",
    ]

    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        w.writerows(rows)

    print(f"✅ Wrote {len(rows)} rows to {csv_path}")


if __name__ == "__main__":
    export_monitors_with_actions(CSV_OUTPUT)