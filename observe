# Exact host from Observe UI (no trailing slash)
# Example: "https://163140281121.cap1.observeinc.com"
OBSERVE_BASE_URL = "https://163140281121.cap1.observeinc.com"

OBSV_USER_EMAIL = "service-account@your-company.com"
OBSV_USER_PASSWORD = "YOUR_PASSWORD"
TOKEN_NAME = "api-monitor-export"

CSV_OUTPUT = "observe_monitors_actions.csv"


# ---------------- LOGIN ----------------

def login_and_get_auth():
    """
    Call /v1/login and return (customer_id, access_key).
    Matches the response you've shown:
      {"ok": true, "access_key": "...", "customer_id": 1631402...}
    """
    url = f"{OBSERVE_BASE_URL}/v1/login"
    payload = {
        "user_email": OBSV_USER_EMAIL,
        "user_password": OBSV_USER_PASSWORD,
        "tokenName": TOKEN_NAME,
    }

    resp = requests.post(url, json=payload, timeout=30)
    if resp.status_code != 200:
        raise Exception(f"Login failed: {resp.status_code} → {resp.text}")

    data = resp.json()
    access_key = data.get("access_key")
    customer_id = data.get("customer_id")

    if not access_key or not customer_id:
        raise Exception(f"Login succeeded but access_key/customer_id missing: {data}")

    print("✅ Login successful")
    return str(customer_id), access_key


# ------------- FETCH MONITORS -------------

def fetch_all_monitors(customer_id, access_key):
    """
    Fetch all monitors from /v1/monitors.
    In your env /v1/monitors returns a top-level LIST.
    """
    headers = {
        "Authorization": f"Bearer {customer_id} {access_key}",
        "Content-Type": "application/json",
    }

    url = f"{OBSERVE_BASE_URL}/v1/monitors"
    resp = requests.get(url, headers=headers, timeout=30)

    if resp.status_code != 200:
        raise Exception(f"/v1/monitors failed: {resp.status_code} → {resp.text}")

    data = resp.json()
    if isinstance(data, list):
        return data
    elif isinstance(data, dict):
        # just in case your tenant wraps it
        return data.get("data") or data.get("monitors") or []
    else:
        raise Exception(f"Unexpected /v1/monitors JSON type: {type(data)}")


# --------- EXTRACT FIELDS FROM MONITOR ---------

def get_monitor_id(m):
    return str(m.get("id") or m.get("monitor_id") or m.get("_id") or "")


def get_monitor_name(m):
    return str(m.get("name") or m.get("monitor_name") or "")


def get_monitor_created_by(m):
    return (
        m.get("created_by")
        or (m.get("meta") or {}).get("created_by")
        or (m.get("metadata") or {}).get("createdBy")
        or ""
    )


def get_monitor_status(m):
    if "enabled" in m:
        return "enabled" if m.get("enabled") else "disabled"
    if "disabled" in m:
        return "disabled" if m.get("disabled") else "enabled"
    return ""


# --------- INLINE PAGERDUTY ACTIONS ---------

def extract_monitor_actions(m):
    """
    Your tenant puts PagerDuty payloads directly under one of:
      - notification_actions
      - actions
      - notifications
    Each element is already the PD JSON (dedup_key, payload, routing_key, client, client_url, ...).
    """
    for key in ("notification_actions", "actions", "notifications"):
        if key in m and isinstance(m[key], list):
            return m[key]
    return []


def summarize_inline_pd_action(act):
    """
    Summarize a single inline PagerDuty action, based on your sample JSON:
      {
        "routing_key": "...",
        "client": "Observe Alert Link",
        "client_url": "https://...",
        "payload": {
          "summary": "...",
          "severity": "error",
          "timestamp": "...",
          ...
        },
        ...
      }
    """
    payload = act.get("payload", {}) if isinstance(act.get("payload"), dict) else {}

    routing_key = act.get("routing_key", "")
    client = act.get("client", "")
    client_url = act.get("client_url", "")

    summary = payload.get("summary", "")
    severity = payload.get("severity", "")
    timestamp = payload.get("timestamp", "")

    return {
        "routing_key": routing_key,
        "client": client,
        "client_url": client_url,
        "summary": summary,
        "severity": severity,
        "timestamp": timestamp,
        "raw_action_json": json.dumps(act),
    }


# ------------- MAIN EXPORT -------------

def export_monitors(csv_path):
    customer_id, access_key = login_and_get_auth()
    monitors = fetch_all_monitors(customer_id, access_key)

    print(f"Fetched {len(monitors)} monitors")

    rows = []

    for m in monitors:
        mid = get_monitor_id(m)
        name = get_monitor_name(m)
        created_by = get_monitor_created_by(m)
        status = get_monitor_status(m)

        actions = extract_monitor_actions(m)

        if not actions:
            rows.append({
                "monitor_id": mid,
                "monitor_name": name,
                "created_by": created_by,
                "status": status,
                "routing_key": "",
                "client": "",
                "client_url": "",
                "summary": "",
                "severity": "",
                "timestamp": "",
                "raw_action_json": "",
            })
            continue

        for act in actions:
            pd = summarize_inline_pd_action(act)
            rows.append({
                "monitor_id": mid,
                "monitor_name": name,
                "created_by": created_by,
                "status": status,
                **pd,
            })

    fieldnames = [
        "monitor_id",
        "monitor_name",
        "created_by",
        "status",
        "routing_key",
        "client",
        "client_url",
        "summary",
        "severity",
        "timestamp",
        "raw_action_json",
    ]

    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    print(f"✅ CSV written → {csv_path}")


if __name__ == "__main__":
    export_monitors(CSV_OUTPUT)