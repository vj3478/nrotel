OBSERVE_BASE_URL = "https://163140281121.cap1.observeinc.com"

OBSV_USER_EMAIL = "service-account@your-company.com"
OBSV_USER_PASSWORD = "YOUR_PASSWORD"
TOKEN_NAME = "api-monitor-export"

CSV_OUTPUT = "observe_monitors_with_actions.csv"


# ---------------- LOGIN ----------------

def login_and_get_auth():
    """
    Call /v1/login and return (customer_id, access_key).
    Matches the response you showed:
      {"ok": true, "access_key": "...", "customer_id": 1631402...}
    """
    url = f"{OBSERVE_BASE_URL}/v1/login"
    payload = {
        "user_email": OBSV_USER_EMAIL,
        "user_password": OBSV_USER_PASSWORD,
        "tokenName": TOKEN_NAME,
    }

    resp = requests.post(url, json=payload, timeout=30)
    if resp.status_code != 200:
        raise Exception(f"Login failed ({resp.status_code}): {resp.text}")

    data = resp.json()
    access_key = data.get("access_key")
    customer_id = data.get("customer_id")
    if not access_key or not customer_id:
        raise Exception(f"Login succeeded but access_key/customer_id missing: {data}")

    print("✅ Login successful")
    return str(customer_id), access_key


# ------------- FETCH MONITORS -------------

def fetch_all_monitors(customer_id, access_key):
    """
    Fetch all monitors from /v1/monitors.
    In your env /v1/monitors returns a top-level LIST.
    """
    headers = {
        "Authorization": f"Bearer {customer_id} {access_key}",
        "Content-Type": "application/json",
    }

    url = f"{OBSERVE_BASE_URL}/v1/monitors"
    resp = requests.get(url, headers=headers, timeout=30)

    if resp.status_code == 401:
        raise Exception("❌ 401 Unauthorized from /v1/monitors – check Authorization header.")
    if resp.status_code == 403:
        raise Exception("❌ 403 Forbidden – service account lacks monitor permissions.")
    if resp.status_code != 200:
        raise Exception(f"❌ API error {resp.status_code}: {resp.text}")

    data = resp.json()
    if isinstance(data, list):
        return data
    elif isinstance(data, dict):
        return data.get("data") or data.get("monitors") or []
    else:
        raise Exception(f"Unexpected /v1/monitors JSON type: {type(data)}")


# --------- BASIC MONITOR FIELDS ---------

def get_monitor_id(m):
    return str(m.get("id") or m.get("monitor_id") or m.get("_id") or "")


def get_monitor_name(m):
    return str(m.get("name") or m.get("monitor_name") or "")


def get_monitor_created_by(m):
    return (
        m.get("created_by")
        or (m.get("meta") or {}).get("created_by")
        or (m.get("metadata") or {}).get("createdBy")
        or ""
    )


def get_monitor_status(m):
    if "enabled" in m:
        return "enabled" if m.get("enabled") else "disabled"
    if "disabled" in m:
        return "disabled" if m.get("disabled") else "enabled"
    return ""


# --------- ACTION / SHARED-ACTION HELPERS ---------

def extract_actions(m):
    """
    Try hard to locate the list of notification / actions on a monitor.
    """
    # Most common in Observe v1 monitors
    for key in (
        "notification_actions",
        "notificationActions",
        "notifications",
        "actions",
    ):
        v = m.get(key)
        if isinstance(v, list):
            return v

    # Fallback: sometimes a single action object
    for key in (
        "notification_action",
        "notificationAction",
        "action",
    ):
        v = m.get(key)
        if isinstance(v, dict):
            return [v]

    return []


def summarize_action(act):
    """
    Summarize a single monitor action / notification, handling nested
    'shared_action' or 'action' objects, and always include raw JSON.
    """

    # Many schemas wrap the actual shared action here:
    # { "severities": [...], "shared_action": { ... } }
    # or { "severities": [...], "action": { ... } }
    shared_obj = None

    if isinstance(act.get("shared_action"), dict):
        shared_obj = act["shared_action"]
    elif isinstance(act.get("sharedAction"), dict):
        shared_obj = act["sharedAction"]
    elif isinstance(act.get("action"), dict):
        shared_obj = act["action"]

    # If we found a nested object, use that as the base; otherwise use act itself
    base = shared_obj if shared_obj is not None else act
    is_shared = "yes" if shared_obj is not None else (
        "yes" if base.get("shared_action_id") or base.get("sharedActionId") else "no"
    )

    def first_non_empty(*keys):
        for k in keys:
            if k in base and base.get(k):
                return base.get(k)
            if k in act and act.get(k):
                return act.get(k)
        return ""

    action_type = first_non_empty("type", "action_type", "channel_type", "kind")
    channel = first_non_empty("channel", "notificationChannel", "integration_type", "provider")
    target = first_non_empty(
        "email",
        "address",
        "url",
        "endpoint",
        "target",
        "service_key",
        "routing_key",
    )
    shared_action_id = first_non_empty(
        "shared_action_id",
        "sharedActionId",
        "shared_action_uuid",
        "id",
        "uuid",
    )

    severities = act.get("severities") or act.get("severity_filter") or act.get("severity") or ""

    return {
        "action_type": str(action_type),
        "action_channel": str(channel),
        "action_target": str(target),
        "is_shared_action": "yes" if is_shared == "yes" else "no",
        "shared_action_id": str(shared_action_id),
        "action_severities": ",".join(severities) if isinstance(severities, list) else str(severities),
        # always include the raw JSON so you can see everything
        "raw_action_json": json.dumps(act),
    }


# ------------- MAIN EXPORT -------------

def export_monitors_with_actions(csv_path):
    customer_id, access_key = login_and_get_auth()

    monitors = fetch_all_monitors(customer_id, access_key)
    print(f"Fetched {len(monitors)} monitors")

    # If you want to see the raw shape once, uncomment:
    # print(json.dumps(monitors[0], indent=2))

    rows = []

    for m in monitors:
        mid = get_monitor_id(m)
        name = get_monitor_name(m)
        created_by = get_monitor_created_by(m)
        status = get_monitor_status(m)

        actions = extract_actions(m)

        if not actions:
            rows.append(
                {
                    "monitor_id": mid,
                    "monitor_name": name,
                    "created_by": created_by,
                    "status": status,
                    "action_type": "",
                    "action_channel": "",
                    "action_target": "",
                    "action_severities": "",
                    "is_shared_action": "",
                    "shared_action_id": "",
                    "raw_action_json": "",
                }
            )
            continue

        for act in actions:
            a = summarize_action(act)
            rows.append(
                {
                    "monitor_id": mid,
                    "monitor_name": name,
                    "created_by": created_by,
                    "status": status,
                    **a,
                }
            )

    fieldnames = [
        "monitor_id",
        "monitor_name",
        "created_by",
        "status",
        "action_type",
        "action_channel",
        "action_target",
        "action_severities",
        "is_shared_action",
        "shared_action_id",
        "raw_action_json",
    ]

    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        w.writerows(rows)

    print(f"✅ Wrote {len(rows)} rows to {csv_path}")


if __name__ == "__main__":
    export_monitors_with_actions(CSV_OUTPUT)