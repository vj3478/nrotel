#!/usr/bin/env python3
"""
observe_export_all.py

Exports:
  - All Monitors (full details)
  - All Shared Actions (full details)

Outputs:
  - monitors.csv
  - shared_actions.csv
"""

import os
import sys
import csv
import json
import time
import argparse
from typing import Any, Dict, List, Optional
import requests

# ============================================================
# 🔹 REQUIRED CONFIGURATION (can be overridden by ENV / CLI)
# ============================================================

# ---- Base / Auth ----
DEFAULT_BASE_URL = os.getenv("OBSERVE_BASE_URL", "")
DEFAULT_USERNAME = os.getenv("OBSERVE_USERNAME", "")
DEFAULT_PASSWORD = os.getenv("OBSERVE_PASSWORD", "")

# ---- Output ----
DEFAULT_OUTPUT_DIR = os.getenv("OUTPUT_DIR", ".")
DEFAULT_MONITORS_CSV = "monitors.csv"
DEFAULT_SHARED_ACTIONS_CSV = "shared_actions.csv"

# ---- SSL ----
DEFAULT_CA_BUNDLE = os.getenv("REQUESTS_CA_BUNDLE")  # path to PEM
DEFAULT_INSECURE = False  # DO NOT set True in prod

# ---- API Endpoints ----
LOGIN_PATH = "/v1/login"

LIST_MONITORS_PATH = "/v1/monitors"
GET_MONITOR_PATH = "/v1/monitors/{id}"

LIST_SHARED_ACTIONS_PATH = "/v1/shared_actions"
GET_SHARED_ACTION_PATH = "/v1/shared_actions/{id}"

# ---- General Behavior ----
HTTP_TIMEOUT = 30
FLATTEN_MAX_DEPTH = 6
DETAIL_CALL_SLEEP_SECONDS = 0.0

# ---- ID candidates (API inconsistencies handled here) ----
MONITOR_ID_KEYS = ["id", "monitorId", "uuid", "guid", "slug"]
SHARED_ACTION_ID_KEYS = ["id", "actionId", "sharedActionId", "uuid", "guid"]

# ============================================================
# 🔹 Utility helpers
# ============================================================

def eprint(*args):
    print(*args, file=sys.stderr)


def safe_json(obj) -> str:
    try:
        return json.dumps(obj, ensure_ascii=False, default=str)
    except Exception:
        return json.dumps({"_error": "non-serializable"})


def flatten_json(obj, parent="", sep=".", depth=0, max_depth=FLATTEN_MAX_DEPTH):
    flat = {}
    if depth > max_depth:
        flat[parent] = safe_json(obj)
        return flat

    if isinstance(obj, dict):
        for k, v in obj.items():
            key = f"{parent}{sep}{k}" if parent else k
            flat.update(flatten_json(v, key, sep, depth + 1))
    elif isinstance(obj, list):
        flat[parent] = safe_json(obj)
    else:
        flat[parent] = obj

    return flat


def pick_id(obj: Dict[str, Any], keys: List[str]) -> Optional[str]:
    for k in keys:
        v = obj.get(k)
        if v:
            return str(v)
    return None


def write_csv(rows: List[Dict[str, Any]], path: str):
    keys = []
    seen = set()
    for r in rows:
        for k in r:
            if k not in seen:
                seen.add(k)
                keys.append(k)

    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=keys)
        writer.writeheader()
        writer.writerows(rows)


# ============================================================
# 🔹 Client
# ============================================================

class ObserveClient:
    def __init__(self, base_url, username, password, verify):
        self.base_url = base_url.rstrip("/")
        self.verify = verify
        self.session = requests.Session()
        self.session.headers.update({
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": "observe-export/2.0",
        })
        self._login(username, password)

    def _login(self, username, password):
        r = self.session.post(
            self.base_url + LOGIN_PATH,
            json={"username": username, "password": password},
            timeout=HTTP_TIMEOUT,
            verify=self.verify,
        )
        r.raise_for_status()
        token = r.json().get("token")
        if not token:
            raise RuntimeError("Login succeeded but token missing")
        self.session.headers["Authorization"] = f"Bearer {token}"

    def get(self, path):
        r = self.session.get(
            self.base_url + path,
            timeout=HTTP_TIMEOUT,
            verify=self.verify,
        )
        r.raise_for_status()
        return r.json()


# ============================================================
# 🔹 Export logic
# ============================================================

def export_entity(
    client: ObserveClient,
    list_path: str,
    detail_path: str,
    id_keys: List[str],
    label: str,
) -> List[Dict[str, Any]]:

    data = client.get(list_path)
    items = data.get("items") or data.get("data") or data

    rows = []

    for idx, item in enumerate(items, 1):
        base = flatten_json(item)
        base["raw_json_list"] = safe_json(item)

        entity_id = pick_id(item, id_keys)
        if not entity_id:
            base["details_error"] = "ID not found"
            rows.append(base)
            continue

        try:
            detail = client.get(detail_path.format(id=entity_id))
            flat = flatten_json(detail)
            row = {**base, **flat}
            row["id"] = entity_id
            row["raw_json"] = safe_json(detail)
            rows.append(row)
        except Exception as e:
            base["details_error"] = str(e)
            rows.append(base)

        if idx % 25 == 0:
            eprint(f"{label}: {idx}/{len(items)} processed")

        if DETAIL_CALL_SLEEP_SECONDS:
            time.sleep(DETAIL_CALL_SLEEP_SECONDS)

    return rows


# ============================================================
# 🔹 Main
# ============================================================

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    parser.add_argument("--username", default=DEFAULT_USERNAME)
    parser.add_argument("--password", default=DEFAULT_PASSWORD)
    parser.add_argument("--out-dir", default=DEFAULT_OUTPUT_DIR)
    parser.add_argument("--ca-bundle", default=DEFAULT_CA_BUNDLE)
    parser.add_argument("--insecure", action="store_true")
    args = parser.parse_args()

    if not all([args.base_url, args.username, args.password]):
        raise SystemExit("❌ base-url, username, password are required")

    verify = False if args.insecure else (args.ca_bundle or True)

    client = ObserveClient(
        args.base_url,
        args.username,
        args.password,
        verify,
    )

    # ---- Monitors ----
    monitors = export_entity(
        client,
        LIST_MONITORS_PATH,
        GET_MONITOR_PATH,
        MONITOR_ID_KEYS,
        "Monitors",
    )

    write_csv(
        monitors,
        os.path.join(args.out_dir, DEFAULT_MONITORS_CSV),
    )

    # ---- Shared Actions ----
    actions = export_entity(
        client,
        LIST_SHARED_ACTIONS_PATH,
        GET_SHARED_ACTION_PATH,
        SHARED_ACTION_ID_KEYS,
        "SharedActions",
    )

    write_csv(
        actions,
        os.path.join(args.out_dir, DEFAULT_SHARED_ACTIONS_CSV),
    )

    eprint("✅ Export completed")


if __name__ == "__main__":
    main()