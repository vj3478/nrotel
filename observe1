#!/usr/bin/env python3
import argparse
import json
import os
import sys
from typing import Any, Dict, Optional

import requests
import urllib3


DEFAULT_OUTPUT_DIR = "."
DEFAULT_CA_BUNDLE = None


class ObserveClient:
    """
    Minimal Observe client:
      - login (session cookie based) OR token header (if you switch it)
      - request wrapper with verify handling
      - example functions: list_monitors, list_shared_actions
    """

    def __init__(self, base_url: str, username: str, password: str, verify: Any, timeout: int = 30):
        self.base_url = base_url.rstrip("/")
        self.username = username
        self.password = password
        self.verify = verify
        self.timeout = timeout

        self.session = requests.Session()
        self.session.verify = verify

        # Helpful defaults
        self.session.headers.update({
            "Accept": "application/json",
        })

        print(f"[INFO] Base URL      = {self.base_url}")
        print(f"[INFO] SSL verify   = {self.verify}")

        self._login()

    def _url(self, path: str) -> str:
        if not path.startswith("/"):
            path = "/" + path
        return f"{self.base_url}{path}"

    def _request(
        self,
        method: str,
        path: str,
        *,
        params: Optional[Dict[str, Any]] = None,
        json_body: Optional[Dict[str, Any]] = None,
        headers: Optional[Dict[str, str]] = None,
        allow_404: bool = False,
        debug: bool = False,
    ) -> requests.Response:
        url = self._url(path)

        req_headers = {}
        if headers:
            req_headers.update(headers)

        if debug:
            print(f"[DEBUG] {method} {url}")
            if params:
                print(f"[DEBUG] params: {params}")
            if json_body:
                print(f"[DEBUG] json keys: {list(json_body.keys())}")

        resp = self.session.request(
            method=method.upper(),
            url=url,
            params=params,
            json=json_body,
            headers=req_headers if req_headers else None,
            timeout=self.timeout,
        )

        if allow_404 and resp.status_code == 404:
            return resp

        if not resp.ok:
            # Print body for fast debugging (400/401/403/etc)
            print(f"[ERROR] HTTP {resp.status_code} calling {method} {url}")
            ct = resp.headers.get("Content-Type", "")
            if "application/json" in ct:
                try:
                    print(json.dumps(resp.json(), indent=2))
                except Exception:
                    print(resp.text)
            else:
                print(resp.text)
            resp.raise_for_status()

        return resp

    def _login(self) -> None:
        """
        Your screenshot shows /v1/login. Many Observe tenants use cookie-based sessions.
        If your API returns a token instead, we can store it and attach Authorization header.
        """
        path = "/v1/login"

        payload = {
            "username": self.username,
            "password": self.password,
        }

        headers = {"Content-Type": "application/json"}

        resp = self._request("POST", path, json_body=payload, headers=headers)

        # If login returns JSON with token, you can enable this:
        # data = resp.json()
        # token = data.get("accessToken") or data.get("token")
        # if token:
        #     self.session.headers.update({"Authorization": f"Bearer {token}"})

        print("[SUCCESS] Login OK")

    # ----------------------------
    # Example “other functions”
    # ----------------------------

    def list_monitors(self) -> Dict[str, Any]:
        """
        Update endpoint if your repo uses a different one.
        """
        # Common patterns might be:
        #   /v1/monitors
        #   /v1/monitor
        #   /v1/alerts/monitors
        path = "/v1/monitors"
        resp = self._request("GET", path)
        return resp.json()

    def list_shared_actions(self) -> Dict[str, Any]:
        """
        Update endpoint if needed.
        """
        # Common patterns might be:
        #   /v1/sharedActions
        #   /v1/shared-actions
        #   /v1/actions/shared
        path = "/v1/sharedActions"
        resp = self._request("GET", path)
        return resp.json()

    def get_monitor_details(self, monitor_id: str) -> Dict[str, Any]:
        """
        If your API has a per-monitor endpoint, call it here.
        """
        path = f"/v1/monitors/{monitor_id}"
        resp = self._request("GET", path, allow_404=False)
        return resp.json()


def write_json(out_dir: str, name: str, data: Any) -> str:
    os.makedirs(out_dir, exist_ok=True)
    p = os.path.join(out_dir, name)
    with open(p, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    return p


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--base-url", required=True)
    parser.add_argument("--username", required=True)
    parser.add_argument("--password", required=True)

    parser.add_argument("--out-dir", default=DEFAULT_OUTPUT_DIR)
    parser.add_argument("--ca-bundle", default=DEFAULT_CA_BUNDLE)
    parser.add_argument("--insecure", action="store_true")

    # Actions
    parser.add_argument("--export-monitors", action="store_true")
    parser.add_argument("--export-shared-actions", action="store_true")
    parser.add_argument("--monitor-id", help="Fetch details for a single monitor by id")

    args = parser.parse_args()

    # SSL verify logic (explicit + predictable)
    if args.insecure:
        verify = False
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
    elif args.ca_bundle:
        verify = args.ca_bundle
    else:
        verify = True

    client = ObserveClient(
        base_url=args.base_url,
        username=args.username,
        password=args.password,
        verify=verify,
    )

    did_anything = False

    if args.export_monitors:
        did_anything = True
        monitors = client.list_monitors()
        out = write_json(args.out_dir, "monitors.json", monitors)
        print(f"[OK] Wrote {out}")

    if args.export_shared_actions:
        did_anything = True
        shared = client.list_shared_actions()
        out = write_json(args.out_dir, "shared_actions.json", shared)
        print(f"[OK] Wrote {out}")

    if args.monitor_id:
        did_anything = True
        details = client.get_monitor_details(args.monitor_id)
        out = write_json(args.out_dir, f"monitor_{args.monitor_id}.json", details)
        print(f"[OK] Wrote {out}")

    if not did_anything:
        print("\nNothing selected. Try one of:")
        print("  --export-monitors")
        print("  --export-shared-actions")
        print("  --monitor-id <id>\n")


if __name__ == "__main__":
    main()